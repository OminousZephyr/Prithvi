# Public mobile-app configuration only. Never put service-role or SMS provider secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Optional public URL of the deployed Netlify KisanMitra function.
# This is an endpoint address, not a secret. Leave blank to disable KisanMitra.
EXPO_PUBLIC_KISANMITRA_FUNCTION_URL=https://your-site.netlify.app/.netlify/functions/kisanmitra

# Configure GEMINI_API_KEY only in Netlify Functions environment settings.
# Never add Gemini, SMS provider, or Supabase service-role secrets here.
